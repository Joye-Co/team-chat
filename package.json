{
  "name": "team-chat",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "ops/*"
  ],
  "scripts": {
    "gen:schema": "bun run --cwd packages/protocol gen:schema",
    "gen:fixtures": "bun run --cwd packages/protocol gen:fixtures",
    "test:protocol": "bun run --cwd packages/protocol test",
    "dev:server": "bun run --cwd server dev",
    "test:server": "bun run --cwd server test",
    "typecheck:server": "bun run --cwd server typecheck",
    "admin": "bun server/scripts/admin.ts"
  }
}
