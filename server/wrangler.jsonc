// Worker config. Top level = local dev (`wrangler dev`). Deploy agents fill the D1
// database_id placeholders of each env. ADMIN_SECRET is a secret:
// `wrangler secret put ADMIN_SECRET --env <env>`; for local dev it comes from .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // Invocation logs stay off: they store the full request URL, and /download?code= carries an
  // invite code. The app logger logs every request with its path only (core/worker.ts).
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // Daily archive of every group log and of D1 to R2 (server/src/ops). Keep in sync with ARCHIVE_CRON.
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "ENVIRONMENT": "local", "VERSION": "0.0.0-dev" },
  "d1_databases": [
    { "binding": "DB", "database_name": "chat-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "chat-files-local" }],
  "durable_objects": {
    "bindings": [
      { "name": "MEMBER_GATEWAY", "class_name": "MemberGateway" },
      { "name": "GROUP_ROOM", "class_name": "GroupRoom" },
      { "name": "BOT_DESK", "class_name": "BotDesk" },
      { "name": "MACHINE_LINK", "class_name": "MachineLink" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MemberGateway", "GroupRoom"] },
    { "tag": "v2-bots", "new_sqlite_classes": ["BotDesk", "MachineLink"] }
  ],
  "env": {
    "e2e": {
      "name": "chat-api-e2e",
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "triggers": { "crons": ["0 3 * * *"] },
      "vars": { "ENVIRONMENT": "e2e", "VERSION": "0.0.0-e2e" },
      "d1_databases": [
        { "binding": "DB", "database_name": "chat-e2e", "database_id": "67fb03a3-eabb-40d9-b446-808f301c21f3", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "chat-files-e2e" }],
      "durable_objects": {
        "bindings": [
          { "name": "MEMBER_GATEWAY", "class_name": "MemberGateway" },
          { "name": "GROUP_ROOM", "class_name": "GroupRoom" },
          { "name": "BOT_DESK", "class_name": "BotDesk" },
          { "name": "MACHINE_LINK", "class_name": "MachineLink" }
        ]
      }
    },
    "staging": {
      "name": "chat-api-staging",
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "triggers": { "crons": ["0 3 * * *"] },
      "vars": { "ENVIRONMENT": "staging", "VERSION": "0.0.0-staging" },
      "d1_databases": [
        { "binding": "DB", "database_name": "chat-staging", "database_id": "95271ff5-2e69-4ce7-ba26-bbbdfe29f760", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "chat-files-staging" }],
      "durable_objects": {
        "bindings": [
          { "name": "MEMBER_GATEWAY", "class_name": "MemberGateway" },
          { "name": "GROUP_ROOM", "class_name": "GroupRoom" },
          { "name": "BOT_DESK", "class_name": "BotDesk" },
          { "name": "MACHINE_LINK", "class_name": "MachineLink" }
        ]
      }
    },
    "production": {
      "name": "chat-api-prod",
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "triggers": { "crons": ["0 3 * * *"] },
      "vars": { "ENVIRONMENT": "production", "VERSION": "0.0.0" },
      "d1_databases": [
        { "binding": "DB", "database_name": "chat-prod", "database_id": "6785a4f4-5089-4410-8d30-d38d5cadc413", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "chat-files-prod" }],
      "durable_objects": {
        "bindings": [
          { "name": "MEMBER_GATEWAY", "class_name": "MemberGateway" },
          { "name": "GROUP_ROOM", "class_name": "GroupRoom" },
          { "name": "BOT_DESK", "class_name": "BotDesk" },
          { "name": "MACHINE_LINK", "class_name": "MachineLink" }
        ]
      }
    }
  }
}
