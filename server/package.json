{
  "name": "@chat/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8789 --inspector-port 9789",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "admin": "bun scripts/admin.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:e2e": "bash ../scripts/deploy-server.sh e2e",
    "deploy:staging": "bash ../scripts/deploy-server.sh staging",
    "deploy:production": "bash ../scripts/deploy-server.sh production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@chat/protocol": "workspace:*",
    "@chat/search": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "vitest": "~4.1.12",
    "wrangler": "^4.156.1"
  }
}
