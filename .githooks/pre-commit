#!/usr/bin/env bash
# Formats the staged Rust files before a commit, so `cargo fmt --all --check` in CI stays green.
# A file whose whole change is staged is formatted and staged again; a partly staged file that
# needs formatting stops the commit. Enabled by `bun install` (core.hooksPath = .githooks).
set -euo pipefail

# Only workspace members: CI runs `cargo fmt --all`, which skips third_party/.
files=()
while IFS= read -r -d '' f; do
  case "$f" in
    apps/*.rs | crates/*.rs | tools/e2e/*.rs) files+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.rs')
[ ${#files[@]} -eq 0 ] && exit 0

if ! command -v rustfmt >/dev/null 2>&1 && [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi
if ! command -v rustfmt >/dev/null 2>&1; then
  echo "pre-commit: rustfmt not found, skipping the Rust format check" >&2
  exit 0
fi

edition=$(sed -n 's/^edition *= *"\([0-9]*\)".*/\1/p' Cargo.toml | head -n 1)
bad=()
for f in "${files[@]}"; do
  rustfmt --edition "${edition:-2024}" --check -- "$f" >/dev/null 2>&1 && continue
  if git diff --quiet -- "$f"; then
    rustfmt --edition "${edition:-2024}" -- "$f"
    git add -- "$f"
    echo "pre-commit: formatted $f" >&2
  else
    bad+=("$f")
  fi
done

if [ ${#bad[@]} -gt 0 ]; then
  echo "pre-commit: these files are partly staged and not formatted; run cargo fmt and stage them:" >&2
  printf '  %s\n' "${bad[@]}" >&2
  exit 1
fi
