{
  "title": "TransientEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "typing"
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "topicId": {
          "type": "string",
          "minLength": 1
        },
        "memberId": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "groupId",
        "topicId",
        "memberId",
        "at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "presence"
        },
        "memberId": {
          "type": "string",
          "minLength": 1
        },
        "online": {
          "type": "boolean"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "memberId",
        "online",
        "at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "message.delta"
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "topicId": {
          "type": "string",
          "minLength": 1
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "append": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "groupId",
        "topicId",
        "messageId",
        "append"
      ]
    }
  ]
}
