{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patch ops of a card (ops.json)",
  "minItems": 1,
  "maxItems": 50,
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "set"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "props": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/json"
            }
          }
        },
        "required": [
          "op",
          "id",
          "props"
        ],
        "description": "Merges `props` into the block `id`. It cannot change id, type, children, options or tabs."
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "replace"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "block": {
            "$ref": "CardV2.schema.json#/$defs/block"
          }
        },
        "required": [
          "op",
          "id",
          "block"
        ],
        "description": "Puts `block` in the place of the block `id`. The new block has the same id; its type may differ."
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "insert"
          },
          "block": {
            "$ref": "CardV2.schema.json#/$defs/block"
          },
          "parent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "op",
          "block"
        ],
        "description": "Adds `block`: at the end, or at one of `after` (a block id), `before` (a block id) or `index`. `parent` is the id of a container, a compare option or a tab."
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "remove"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "required": [
          "op",
          "id"
        ],
        "description": "Removes the block `id` and its children."
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "data"
          },
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "value": {
            "$ref": "#/$defs/json"
          }
        },
        "required": [
          "op",
          "path"
        ],
        "description": "Sets `value` at the JSON Pointer `path` of the card's `data` (\"\" is the whole of it); without `value` it deletes."
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "card"
          },
          "props": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "summary": {
                "type": "string",
                "maxLength": 280
              },
              "intent": {
                "$ref": "CardV2.schema.json#/properties/intent"
              },
              "status": {
                "anyOf": [
                  {
                    "$ref": "CardV2.schema.json#/properties/status"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fallback": {
                "type": "string",
                "maxLength": 4000
              },
              "ask": {
                "anyOf": [
                  {
                    "$ref": "CardV2.schema.json#/properties/ask"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actions": {
                "$ref": "CardV2.schema.json#/properties/actions"
              }
            }
          }
        },
        "required": [
          "op",
          "props"
        ],
        "description": "Changes the card itself: title, summary, intent, status, fallback, ask, actions. `status: null` clears the band and `ask: null` closes the question."
      }
    ]
  },
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  }
}
