// Monitor Worker. Top level = the deployed monitor `chat-monitor`, which watches staging and
// production. Each target needs a monitor bot member in that env, in the env's ops group:
//   bun server/scripts/admin.ts bot --env <env> --name monitor   (then add it to the ops group)
//   wrangler secret put MONITOR_TOKEN_STAGING / MONITOR_TOKEN_PRODUCTION   (in ops/monitor)
// `opsGroup` is the ops group's id or exact name. Alerts go to the first healthy target in order.
// env.local runs against a local `wrangler dev` of the API (see docs/RUNBOOK.md).
{
  "$schema": "../../server/node_modules/wrangler/config-schema.json",
  "name": "chat-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "TARGETS": "[{\"name\":\"production\",\"baseUrl\":\"https://chat-api-prod.huangdeshiou.workers.dev\",\"opsGroup\":\"ops\",\"tokenSecret\":\"MONITOR_TOKEN_PRODUCTION\"},{\"name\":\"staging\",\"baseUrl\":\"https://chat-api-staging.huangdeshiou.workers.dev\",\"opsGroup\":\"ops\",\"tokenSecret\":\"MONITOR_TOKEN_STAGING\"}]",
    "FAIL_THRESHOLD": "2",
    "SUMMARY_HOUR_UTC": "1"
  },
  "durable_objects": { "bindings": [{ "name": "MONITOR_STATE", "class_name": "MonitorState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MonitorState"] }],
  "env": {
    "local": {
      "name": "chat-monitor-local",
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "TARGETS": "[{\"name\":\"local\",\"baseUrl\":\"http://127.0.0.1:8798\",\"opsGroup\":\"ops\",\"tokenSecret\":\"MONITOR_TOKEN_LOCAL\"}]",
        "FAIL_THRESHOLD": "2",
        "SUMMARY_HOUR_UTC": "1"
      },
      "durable_objects": { "bindings": [{ "name": "MONITOR_STATE", "class_name": "MonitorState" }] }
    }
  }
}
